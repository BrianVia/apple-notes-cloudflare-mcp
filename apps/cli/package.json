{
  "name": "@notekeeper/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "nk": "./dist/nk.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/nk.js && chmod +x dist/nk.js",
    "build:node": "tsc && chmod +x dist/index.js",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notekeeper/shared": "workspace:*",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3"
  }
}
